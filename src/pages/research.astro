---
import BaseLayout from '../layouts/BaseLayout.astro';

const abstract =
  'Large Language Models (LLMs) are increasingly used for decision-making and planning in autonomous driving, showing promising reasoning capabilities and potential to generalize across diverse traffic situations. However, current LLM-based driving agents lack explicit mechanisms to enforce traffic rules and often struggle to reliably detect small, safety-critical objects such as traffic lights and signs. To address this limitation, we introduce TLS-Assist, a modular redundancy layer that augments LLM-based autonomous driving agents with explicit traffic light and sign recognition. TLS-Assist converts detections into structured natural language messages that are injected into the LLM input, enforcing explicit attention to safety-critical cues. The framework is plug-and-play, model-agnostic, and supports both single-view and multi-view camera setups. We evaluate TLS-Assist in a closed-loop setup on the LangAuto benchmark in CARLA. The results demonstrate relative driving performance improvements of up to 14% over LMDrive and 7% over BEVDriver, while consistently reducing traffic light and sign infractions. We publicly release the code and models.';

const bibtex = `@misc{schmidt2025enhancingllmbasedautonomousdriving,
      title={Enhancing LLM-based Autonomous Driving with Modular Traffic Light and Sign Recognition},
      author={Fabian Schmidt and Noushiq Mohammed Kayilan Abdul Nazar and Markus Enzweiler and Abhinav Valada},
      year={2025},
      eprint={2511.14391},
      archivePrefix={arXiv},
      primaryClass={cs.CV},
      url={https://arxiv.org/abs/2511.14391}
}`;

const modules = [
  {
    index: '01',
    title: 'Detect',
    body: 'Separate YOLO detectors for traffic lights and signs, pre-trained on real-world data and fine-tuned inside CARLA.',
    meta: 'YOLO11 · transfer learning',
  },
  {
    index: '02',
    title: 'Select',
    body: 'A relevance module resolves which light applies to the ego vehicle instead of trusting every detection in frame.',
    meta: 'Geometry · ego context',
  },
  {
    index: '03',
    title: 'Validate',
    body: 'A temporal buffer checks state consistency across frames, suppressing flicker and single-frame errors.',
    meta: 'Temporal reasoning',
  },
  {
    index: '04',
    title: 'Translate',
    body: 'Validated states become structured natural-language notices and are injected directly into the planner prompt.',
    meta: 'Structured language',
  },
];

const metrics = [
  ['Traffic light · YOLO11x', '0.995', '0.856–0.923', '0.997–0.999', '1.000'],
  ['Traffic sign · YOLO11l', '0.995', '0.974', '0.999', '0.998'],
];
---

<BaseLayout
  title="Research"
  description="TLS-Assist: a modular traffic light and sign recognition layer for LLM-based autonomous driving, published at IEEE IV 2026. Paper, results, thesis, and citation."
>
  <header class="research-hero">
    <div class="container">
      <div class="research-hero__top">
        <p class="eyebrow">Research / Publication</p>
        <span class="mono muted">arXiv 2511.14391 · cs.CV</span>
      </div>

      <div class="research-hero__grid">
        <div class="research-hero__copy">
          <p class="research-kicker">IEEE Intelligent Vehicles Symposium 2026</p>
          <h1>Perception as a <em>redundancy layer.</em></h1>
          <p class="research-hero__lead">
            LLM-based drivers can reason about a route. TLS-Assist makes sure they notice the light — by detecting
            traffic lights and signs, selecting the relevant signal, validating it over time, and putting it into
            language the planner already understands.
          </p>
          <p class="research-authors">
            Fabian Schmidt · <strong>Noushiq Mohammed Kayilan Abdul Nazar</strong> · Markus Enzweiler · Abhinav Valada
          </p>
          <p class="research-affil">
            Esslingen University of Applied Sciences · University of Freiburg
          </p>
          <div class="research-actions">
            <a class="btn btn--primary" href="https://arxiv.org/abs/2511.14391" target="_blank" rel="noreferrer">
              Read on arXiv
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="btn btn--ghost" href="/work/tls-assist/">Engineering case study</a>
          </div>
        </div>

        <aside class="paper-facts" aria-label="Publication details">
          <div class="paper-facts__head">
            <span class="mono accent">Paper record</span>
            <span class="paper-facts__status">Published</span>
          </div>
          <dl>
            <div><dt>Venue</dt><dd>IEEE IV 2026</dd></div>
            <div><dt>arXiv</dt><dd>2511.14391 [cs.CV]</dd></div>
            <div><dt>Submitted</dt><dd>18 November 2025</dd></div>
            <div><dt>DOI</dt><dd>10.48550/arXiv.2511.14391</dd></div>
            <div><dt>Code</dt><dd><a href="https://github.com/iis-esslingen/TLS-Assist" target="_blank" rel="noreferrer">iis-esslingen/TLS-Assist ↗</a></dd></div>
            <div><dt>Models</dt><dd><a href="https://huggingface.co/iis-esslingen/TLS-Assist" target="_blank" rel="noreferrer">Hugging Face ↗</a></dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </header>

  <section class="abstract-band" aria-labelledby="abstract-title">
    <div class="container abstract-band__grid">
      <div class="abstract-band__label">
        <p class="eyebrow" id="abstract-title">Abstract</p>
        <span class="mono muted">arXiv v1 · link reference adapted</span>
      </div>
      <blockquote class="abstract-band__text">
        <p>{abstract}</p>
      </blockquote>
    </div>
  </section>

  <section class="section research-figure-section" aria-labelledby="architecture-title">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow reveal">01 / System</p>
          <h2 class="section-title reveal" id="architecture-title" style="--delay: 60ms">
            The whole layer, from camera to <em>prompt.</em>
          </h2>
        </div>
        <p class="section-note reveal" style="--delay: 120ms">
          Image processing feeds two detectors. The relevant light is selected, its state is validated, and the result
          becomes a language notice for the driving agent.
        </p>
      </div>

      <figure class="paper-figure reveal">
        <div class="paper-figure__frame">
          <img
            src="/images/tlsr-architecture.png"
            alt="TLS-Assist architecture: image processing feeds traffic light and sign detection, relevance prediction, state validation, and a message generator connected to the autonomous driving agent"
            width="2200"
            height="950"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          TLS-Assist architecture from the paper. The driving agent is unchanged; the layer acts as a perception sidecar
          and injects structured notices into the prompt.
        </figcaption>
      </figure>

      <div class="module-grid">
        {modules.map((module, i) => (
          <article class="module reveal" style={`--delay: ${i * 60}ms`}>
            <div class="module__head">
              <span class="mono accent">{module.index}</span>
              <span class="mono muted">{module.meta}</span>
            </div>
            <h3>{module.title}</h3>
            <p>{module.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="evidence" aria-labelledby="evidence-title">
    <div class="container">
      <div class="evidence__head">
        <p class="eyebrow">02 / Evidence</p>
        <h2 id="evidence-title">Two kinds of proof: <em>driving</em> and <em>detection.</em></h2>
        <p>
          The paper measures closed-loop driving. The thesis also evaluates the detectors in isolation. They answer
          different questions, so they are reported separately rather than blended into one headline.
        </p>
      </div>

      <div class="evidence__grid">
        <div class="evidence__panel">
          <div class="evidence__panel-head">
            <span class="mono accent">Closed loop</span>
            <span class="mono muted">IEEE IV 2026 · LangAuto / CARLA</span>
          </div>
          <div class="evidence__numbers">
            <div>
              <strong>+14%</strong>
              <span>relative driving performance vs LMDrive</span>
            </div>
            <div>
              <strong>+7%</strong>
              <span>relative driving performance vs BEVDriver</span>
            </div>
          </div>
          <p>
            Across the closed-loop evaluation, TLS-Assist consistently reduced traffic-light and sign infractions. The
            framework was tested with both LMDrive and BEVDriver, in single- and multi-view configurations.
          </p>
        </div>

        <div class="evidence__panel">
          <div class="evidence__panel-head">
            <span class="mono accent">Perception</span>
            <span class="mono muted">Master's thesis · held-out CARLA</span>
          </div>
          <table class="research-table">
            <caption>Fine-tuned detector performance</caption>
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">mAP50</th>
                <th scope="col">mAP50-95</th>
                <th scope="col">P</th>
                <th scope="col">R</th>
              </tr>
            </thead>
            <tbody>
              {metrics.map(([name, map50, map5095, p, r]) => (
                <tr>
                  <td>{name}</td>
                  <td>{map50}</td>
                  <td>{map5095}</td>
                  <td>{p}</td>
                  <td>{r}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="research-table__note">
            Traffic-light results span six cross-validation folds plus an 80:10:10 split. The sign model was trained on a
            purpose-built CARLA dataset. Numbers are from the thesis, not the paper.
          </p>
        </div>
      </div>

      <div class="route-note">
        <span class="mono accent">Route-level signal</span>
        <p>
          On the thesis's LangAuto-Long evaluation, the red-light penalty score fell from <strong>9.7</strong> with
          LMDrive to <strong>3.8</strong> with the traffic-light layer, while the infraction score rose from
          <strong>0.73</strong> to <strong>0.77</strong>. On shorter routes the improvement was smaller — a reminder
          that route length, weather, and traffic density all move the result.
        </p>
      </div>
    </div>
  </section>

  <section class="section research-notes" aria-labelledby="notes-title">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow reveal">03 / Open questions</p>
          <h2 class="section-title reveal" id="notes-title" style="--delay: 60ms">
            What the next version should <em>fix.</em>
          </h2>
        </div>
        <p class="section-note reveal" style="--delay: 120ms">
          The thesis closes with a candid list of limitations. They are still the right agenda.
        </p>
      </div>

      <div class="notes-grid">
        <article class="note reveal">
          <span class="note__index">A</span>
          <h3>Compute</h3>
          <p>
            Two detectors plus an LLM plus a vision encoder is an expensive stack. A shared detection backbone, or
            reuse of the driving agent's vision features, is the obvious next step.
          </p>
        </article>
        <article class="note reveal" style="--delay: 60ms">
          <span class="note__index">B</span>
          <h3>Data</h3>
          <p>
            Fine-tuning used a relatively small volume of CARLA data, and some classes were excluded for lack of
            samples. A dedicated, comprehensive dataset would improve generalization.
          </p>
        </article>
        <article class="note reveal" style="--delay: 120ms">
          <span class="note__index">C</span>
          <h3>Heuristics</h3>
          <p>
            Relevance prediction and state validation are rule-based baselines. They are interpretable and cheap, but a
            learned or probabilistic module could handle occlusions and unusual junctions better.
          </p>
        </article>
        <article class="note reveal" style="--delay: 180ms">
          <span class="note__index">D</span>
          <h3>Variance</h3>
          <p>
            CARLA dynamics and LLM prompt sensitivity introduce run-to-run variance. More seeds, more routes, and
            tighter reporting intervals would make the result easier to trust.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="thesis-section" aria-labelledby="thesis-title">
    <div class="container thesis-grid">
      <div class="thesis-copy">
        <p class="eyebrow">04 / Thesis</p>
        <h2 id="thesis-title">The longer version of the story.</h2>
        <p class="thesis-title">
          Advancing Multi-modal Perception for Closed-Loop End-to-End Autonomous Driving with LLM
        </p>
        <p>
          The master's thesis develops the full TLSR architecture: traffic-light and sign detection, relevance
          prediction, temporal state validation, message generation, and a route-level evaluation inside LMDrive. It
          also contains the ablation study that isolates each module's contribution.
        </p>
        <dl class="thesis-meta">
          <div><dt>Degree</dt><dd>M.Eng. Automotive Systems</dd></div>
          <div><dt>University</dt><dd>Esslingen University of Applied Sciences</dd></div>
          <div><dt>Institute</dt><dd>Institute for Intelligent Systems (IIS)</dd></div>
          <div><dt>Period</dt><dd>19 February – 18 August 2025</dd></div>
          <div><dt>Examiners</dt><dd>Prof. Dr. Markus Enzweiler · Fabian Schmidt, M.Sc.</dd></div>
        </dl>
        <p class="case-note">The thesis document is available on request.</p>
      </div>

      <aside class="citation-card" aria-labelledby="cite-title">
        <div class="citation-card__head">
          <span class="mono accent" id="cite-title">Cite this work</span>
          <button class="copy-btn" type="button" data-copy-bib>Copy BibTeX</button>
        </div>
        <pre id="bibtex"><code>{bibtex}</code></pre>
        <p class="citation-card__note" data-copy-status aria-live="polite">
          arXiv:2511.14391 · IEEE IV 2026
        </p>
      </aside>
    </div>
  </section>

  <section class="research-cta">
    <div class="container research-cta__inner">
      <div>
        <p class="eyebrow reveal">Next</p>
        <h2 class="reveal" style="--delay: 60ms">Read the engineering behind the <em>paper.</em></h2>
      </div>
      <div class="research-cta__actions reveal" style="--delay: 120ms">
        <a class="btn btn--primary" href="/work/tls-assist/">
          TLS-Assist case study
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn--ghost" href="mailto:noushikayilan@gmail.com?subject=Research%20question">Ask a question</a>
      </div>
    </div>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy-bib]');
    const bib = document.querySelector<HTMLElement>('#bibtex');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      if (!bib) return;
      const text = bib.innerText.trim();
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        if (status) status.textContent = 'BibTeX copied to clipboard.';
        window.setTimeout(() => {
          button.textContent = 'Copy BibTeX';
          if (status) status.textContent = 'arXiv:2511.14391 · IEEE IV 2026';
        }, 1800);
      } catch {
        if (status) status.textContent = 'Copy failed — select the BibTeX manually.';
      }
    });
  </script>
</BaseLayout>

