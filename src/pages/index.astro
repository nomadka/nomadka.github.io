---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const proof: Array<[string, string, boolean?]> = [
  ['IEEE IV 2026', 'co-authored'],
  ['+14%', 'vs LMDrive', true],
  ['+7%', 'vs BEVDriver', true],
  ['Data Validation', '2M Frames'],
  ['CARLA', 'closed-loop'],
  ['OpenCV · YOLO · PyTorch · Open3D · Pandas', 'stack'],
];

type HeroSlide = {
  label: string;
  src: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  href: string;
  link: string;
  foot: Array<{ label: string; value: string; tone?: 'amber' | 'green' }>;
  detection?: { x: string; y: string; w: string; h: string; label: string };
};

const slides: HeroSlide[] = [
  {
    label: 'TLS-ASSIST / LANG AUTO',
    src: '/images/hero-carla.webp',
    width: 1200,
    height: 900,
    alt: 'CARLA closed-loop driving scene with three camera views, a yellow traffic light, and natural-language driving notices',
    caption:
      'TLS-Assist — traffic-light and sign perception that turns camera evidence into natural-language notices for an LLM driving agent.',
    href: '/work/tls-assist/',
    link: 'TLS-Assist case study',
    foot: [
      { label: 'VIEWS', value: '03' },
      { label: 'SIGNAL', value: 'YELLOW', tone: 'amber' },
      { label: 'NOTICE', value: 'INJECTED' },
    ],
    detection: { x: '62%', y: '38%', w: '14%', h: '23%', label: 'traffic_light · yellow' },
  },
  {
    label: 'ADMIT14 / EKF TRACK',
    src: '/images/admit14-tracking.webp',
    width: 1136,
    height: 754,
    alt: 'Overhead camera view of a 1:14-scale car tracked around a test track, with a detection box and a blue EKF trajectory',
    caption:
      'ADMIT14 — a 4K overhead camera calibrated to the track; detections are projected to the floor and fused by an EKF into a continuous vehicle state.',
    href: '/work/admit14/',
    link: 'ADMIT14 case study',
    foot: [
      { label: 'SENSOR', value: '4K' },
      { label: 'FILTER', value: 'EKF' },
      { label: 'STATE', value: 'x, y, θ' },
    ],
  },
  {
    label: 'WOOD / DEFECT SCAN',
    src: '/images/hero-wood.webp',
    width: 1200,
    height: 900,
    alt: 'Close-up of a wood plank with YOLO26 detections marking live and dead knots',
    caption:
      'Wood surface defects — a YOLO26 nano detector trained at 320 px, with accuracy and compute budget reported side by side.',
    href: '/work/wood-defects/',
    link: 'Wood defects case study',
    foot: [
      { label: 'MODEL', value: 'YOLO26n' },
      { label: 'mAP50', value: '0.626', tone: 'green' },
      { label: 'BUDGET', value: '5.9 GFLOPs' },
    ],
  },
  {
    label: 'POINT CLOUD / ALIGNED',
    src: '/images/hero-pointclouds.webp',
    width: 1200,
    height: 900,
    alt: 'Aligned point-cloud reconstruction of an indoor scene with a hallway, furniture, and a workspace',
    caption:
      "Point-cloud alignment — three scans brought into a viewer's undocumented frame, reflections included, with an identity trajectory instead of stacked transforms.",
    href: '/work/point-clouds/',
    link: 'Point clouds case study',
    foot: [
      { label: 'SETS', value: '03' },
      { label: 'FRAME', value: 'Y-DOWN' },
      { label: 'METHOD', value: 'Open3D' },
    ],
  },
  {
    label: 'CALIBRATION / INTRINSICS',
    src: '/images/hero-calibration.webp',
    width: 1200,
    height: 900,
    alt: 'Checkerboard calibration target with sub-pixel corner detection and row lines overlaid',
    caption:
      'Camera calibration — intrinsics and distortion recovered from a chessboard, then checked against 26 synthetic views with known ground truth.',
    href: '/work/camera-calibration/',
    link: 'Calibration case study',
    foot: [
      { label: 'TARGET', value: '9×6' },
      { label: 'VIEWS', value: '26' },
      { label: 'CHECK', value: 'REPROJECTION' },
    ],
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--dot reveal">Perception · Autonomous Systems · Germany</p>
        <h1 class="reveal" style="--delay: 70ms">
          Making the physical <em>legible</em> to machines.
        </h1>
        <p class="hero__sub reveal" style="--delay: 140ms">
          I'm Noushiq Mohammed Kayilan Abdul Nazar, a computer vision engineer building perception systems for autonomous driving and robotics. My work turns real-world observations into signals that power intelligent decision-making.
        </p>
        <div class="hero__actions reveal" style="--delay: 210ms">
          <a class="btn btn--primary" href="#work">
            Explore selected work
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn btn--ghost" href="/research/">
            Read the paper
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
        <div class="hero__meta reveal" style="--delay: 280ms">
          <span><b>IEEE IV 2026</b> · co-authored</span>
          <span><b>M.Eng.</b> Automotive Systems</span>
        </div>
      </div>

      <div class="hero__visual reveal" style="--delay: 180ms">
        <div
          class="vision-frame"
          data-slideshow
          data-playing="false"
          data-slides={JSON.stringify(slides)}
          role="group"
          aria-roledescription="carousel"
          aria-label="Selected project imagery across TLS-Assist, ADMIT14, wood defects, point clouds, and camera calibration"
        >
          <div class="vision-frame__bar">
            <span class="vision-frame__live"><i></i> <span data-slide-label>{slides[0].label}</span></span>
            <div class="vision-frame__controls">
              <button type="button" data-slide-prev aria-label="Previous project image">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <span class="vision-frame__count" data-slide-count aria-hidden="true">
                {`01 / ${String(slides.length).padStart(2, '0')}`}
              </span>
              <button type="button" data-slide-next aria-label="Next project image">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M4.5 2.5 8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button type="button" class="vision-frame__toggle" data-slide-toggle aria-label="Play slideshow">
                <svg class="icon-pause" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <rect x="3" y="2.5" width="2" height="7" rx="0.5" fill="currentColor" />
                  <rect x="7" y="2.5" width="2" height="7" rx="0.5" fill="currentColor" />
                </svg>
                <svg class="icon-play" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M4 2.8v6.4L9.2 6 4 2.8Z" fill="currentColor" />
                </svg>
              </button>
            </div>
          </div>
          <div class="vision-frame__media">
            <img
              src={slides[0].src}
              alt={slides[0].alt}
              width={slides[0].width}
              height={slides[0].height}
              fetchpriority="high"
              decoding="async"
              data-slide-image
            />
            <div class="vision-frame__scan" aria-hidden="true"></div>
            {slides[0].detection && (
              <div
                class="detection"
                data-slide-detection
                style={`--x: ${slides[0].detection.x}; --y: ${slides[0].detection.y}; --w: ${slides[0].detection.w}; --h: ${slides[0].detection.h};`}
              >
                <span class="detection__label" data-slide-detection-label>{slides[0].detection.label}</span>
              </div>
            )}
            <div class="vision-frame__reticle" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
          </div>
          <div class="vision-frame__foot">
            {slides[0].foot.map((item) => (
              <div>
                <span data-slide-foot-label>{item.label}</span>
                <strong
                  data-slide-foot
                  class={item.tone === 'amber' ? 'is-amber' : item.tone === 'green' ? 'is-green' : undefined}
                >
                  {item.value}
                </strong>
              </div>
            ))}
          </div>
        </div>
        <p class="hero__caption">
          <span data-slide-caption>{slides[0].caption}</span>
          <a class="hero__caption-link" href={slides[0].href} data-slide-link>
            <span data-slide-link-label>{slides[0].link}</span>
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <div class="proof" aria-label="Selected proof points">
    <div class="proof__track">
      <div class="proof__group">
        {proof.map(([strong, rest, accent]) => (
          <span class:list={['proof__item', { 'proof__item--accent': accent }]}><b>{strong}</b> {rest}</span>
        ))}
      </div>
      <div class="proof__group" aria-hidden="true">
        {proof.map(([strong, rest, accent]) => (
          <span class:list={['proof__item', { 'proof__item--accent': accent }]}><b>{strong}</b> {rest}</span>
        ))}
      </div>
    </div>
  </div>

  <section class="section" id="work">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow reveal">01 / Selected work</p>
          <h2 class="section-title reveal" style="--delay: 60ms">
            Perception, geometry, and the systems <em>in between.</em>
          </h2>
        </div>
        <a class="link-arrow reveal" style="--delay: 120ms" href="/work/">
          All projects
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <a class="work-feature card reveal" href="/work/tls-assist/">
        <div class="work-feature__media">
          <img
            src="/images/tlsr-stop.webp"
            alt="CARLA driving scene approaching a stop sign, with multi-view cameras and a traffic-sign notice"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <span class="work-feature__badge">Flagship / Research</span>
        </div>
        <div class="work-feature__body">
          <div class="work-feature__top">
            <span class="mono muted">01</span>
            <span class="mono accent">IEEE IV 2026</span>
          </div>
          <h3>TLS-Assist</h3>
          <p>
            Giving an LLM driver explicit traffic-rule perception: a modular layer that detects lights and signs, validates their state, and turns them into language the planner can use.
          </p>
          <div class="work-feature__metric">
            <strong>+14%</strong>
            <span>relative driving performance vs LMDrive, with fewer traffic-light and sign infractions.</span>
          </div>
          <ul class="tag-list">
            <li class="tag">Autonomous driving</li>
            <li class="tag">YOLO11</li>
            <li class="tag">CARLA</li>
            <li class="tag">PyTorch</li>
          </ul>
          <span class="link-arrow">
            Read the case study
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </a>

      <div class="work-grid">
        <ProjectCard
          href="/work/admit14/"
          index="02"
          title="ADMIT14 localization"
          description="Replacing indoor GPS with a calibrated hall-roof camera: checkerboard calibration, overhead detection, and EKF tracking for a 1:14-scale driving environment."
          image="/images/admit14-card.webp"
          alt="Overhead view of a scaled test track with a model car selected for labelling"
          meta="Autonomous systems"
          tags={['MATLAB', 'EKF', 'Calibration']}
        />
        <ProjectCard
          href="/work/wood-defects/"
          index="03"
          title="Wood surface defect detection"
          description="An end-to-end YOLO26 nano pipeline that takes a Kaggle dataset from raw labels to real-time inference — sized for edge deployment."
          image="/images/wood-card.webp"
          alt="Wood defect detection results: a plank with live-knot and dead-knot detections, plus validation crops"
          meta="Applied CV"
          tags={['YOLO26n', 'Edge', 'Python']}
        />
        <ProjectCard
          href="/work/point-clouds/"
          index="04"
          title="Point-cloud alignment"
          description="Reconstructing the exact transform between three point-cloud datasets and a custom 3D viewer with its own hidden coordinate convention."
          image="/images/pcd-card.webp"
          alt="Aligned point cloud of an indoor scene inside a custom 3D viewer, with a raw misaligned inset and coordinate axes"
          meta="3D geometry"
          tags={['Open3D', 'NumPy', 'Python']}
        />
        <ProjectCard
          href="/work/camera-calibration/"
          index="05"
          title="Camera calibration toolkit"
          description="A reusable OpenCV module for intrinsics, distortion, undistortion, and reprojection-error checks."
          image="/images/calibration-target.webp"
          alt="Calibration target with a checkerboard, coordinate axes, and measurement grid"
          meta="Tooling"
          tags={['OpenCV', 'Calibration', 'Python']}
        />
      </div>
    </div>
  </section>

  <section class="paper-section" id="research">
    <div class="container">
      <div class="paper-grid">
        <div class="paper-copy reveal">
          <p class="eyebrow">02 / Publication</p>
          <p class="paper-venue">IEEE Intelligent Vehicles Symposium 2026</p>
          <h2 class="paper-title">
            Enhancing LLM-based Autonomous Driving with Modular Traffic Light and Sign Recognition
          </h2>
          <p class="paper-authors">
            Fabian Schmidt · <strong>Noushiq Mohammed Kayilan Abdul Nazar</strong> · Markus Enzweiler · Abhinav Valada
          </p>
          <p class="paper-abstract">
            LLM-based driving agents can reason, but they do not reliably attend to small, safety-critical objects. TLS-Assist adds a modular perception layer that detects traffic lights and signs, selects the signal relevant to the ego vehicle, validates its state, and injects structured natural-language cues into the planner.
          </p>
          <div class="paper-metrics">
            <div><strong>+14%</strong><span>vs LMDrive</span></div>
            <div><strong>+7%</strong><span>vs BEVDriver</span></div>
            <div><strong>2</strong><span>closed-loop agents</span></div>
          </div>
          <div class="paper-actions">
            <a class="btn btn--dark" href="https://arxiv.org/abs/2511.14391" target="_blank" rel="noreferrer">
              Read the paper
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="link-arrow paper-link" href="/work/tls-assist/">
              Case study
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
        <figure class="paper-figure reveal" style="--delay: 100ms">
          <div class="paper-figure__frame">
            <img
              src="/images/tls-assist-architecture.webp"
              alt="TLS-Assist architecture: three camera views feed preprocessing, traffic-light detection with YOLO11x and traffic-sign detection with YOLO11l, then relevance prediction, state validation, prioritization, a message generator, and the LLM-based driving agent"
              width="3483"
              height="993"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>The TLS-Assist pipeline: from three camera views to structured language for the driving agent.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="stack">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow reveal">03 / Capabilities</p>
          <h2 class="section-title reveal" style="--delay: 60ms">
            From photons to <em>decisions.</em>
          </h2>
        </div>
        <p class="section-note reveal" style="--delay: 120ms">
          A perception stack built across simulation, geometry, and language — with an emphasis on systems that can be evaluated, not just demoed.
        </p>
      </div>

      <div class="stack-pipeline reveal">
        <div class="stack-step">
          <span>01 / Sense</span>
          <strong>Cameras &amp; sensors</strong>
          <p>Multi-view RGB, simulated sensor rigs, calibration, and undistortion.</p>
        </div>
        <div class="stack-step">
          <span>02 / Detect</span>
          <strong>Objects &amp; state</strong>
          <p>YOLO detectors, fine-tuning, relevance filtering, and temporal validation.</p>
        </div>
        <div class="stack-step">
          <span>03 / Reason</span>
          <strong>Language &amp; planning</strong>
          <p>Structured prompts, VLMs, LLM planners, and closed-loop simulation.</p>
        </div>
        <div class="stack-step">
          <span>04 / Act</span>
          <strong>Measured behaviour</strong>
          <p>Infraction scores, driving performance, and reproducible evaluation.</p>
        </div>
      </div>

      <div class="stack-grid">
        <div class="stack-group reveal">
          <h3>Perception</h3>
          <ul class="tag-list">
            <li class="tag">PyTorch</li>
            <li class="tag">YOLO11</li>
            <li class="tag">OpenCV</li>
            <li class="tag">Open3D</li>
            <li class="tag">NumPy</li>
          </ul>
        </div>
        <div class="stack-group reveal" style="--delay: 70ms">
          <h3>Autonomy</h3>
          <ul class="tag-list">
            <li class="tag">CARLA</li>
            <li class="tag">LMDrive</li>
            <li class="tag">BEVDriver</li>
            <li class="tag">LangAuto</li>
          </ul>
        </div>
        <div class="stack-group reveal" style="--delay: 140ms">
          <h3>Multimodal AI</h3>
          <ul class="tag-list">
            <li class="tag">LangChain</li>
            <li class="tag">Ollama</li>
            <li class="tag">Chroma</li>
            <li class="tag">Hugging Face</li>
          </ul>
        </div>
        <div class="stack-group reveal" style="--delay: 210ms">
          <h3>Engineering</h3>
          <ul class="tag-list">
            <li class="tag">Python</li>
            <li class="tag">C++</li>
            <li class="tag">MATLAB</li>
            <li class="tag">Git</li>
            <li class="tag">Docker</li>
            <li class="tag">Linux</li>
            <li class="tag">LaTeX</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--line" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-copy reveal">
          <p class="eyebrow">04 / About</p>
          <h2 class="section-title">
            I work where perception meets <em>language.</em>
          </h2>
          <p class="about-lead">
            My master's thesis built a traffic light and sign perception layer for LMDrive, an LLM-based driving agent evaluated in closed-loop CARLA simulation. That work became TLS-Assist, published at IEEE IV 2026.
          </p>
          <p>
            I care about the unglamorous parts: coordinate conventions, label quality, relevance logic, failure modes, and whether the metric actually reflects driving behaviour. The interesting problems usually live between the modules.
          </p>
          <a class="link-arrow" href="/about/">
            More about me
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

        <div class="terminal reveal" style="--delay: 100ms" aria-label="A short profile in terminal form">
          <div class="terminal__bar">
            <span></span><span></span><span></span>
            <em>noushiq@perception:~</em>
          </div>
          <div class="terminal__body">
            <p><span class="prompt">$</span> whoami</p>
            <p class="out">noushiq kayilan</p>
            <p><span class="prompt">$</span> cat focus.txt</p>
            <p class="out">computer vision<br />autonomous driving<br />multimodal perception</p>
            <p><span class="prompt">$</span> currently</p>
            <p class="out">vision-language models · sensor fusion · world models</p>
            <p><span class="prompt">$</span> location</p>
            <p class="out green">germany</p>
            <p class="cursor"><span class="prompt">$</span> <span class="blink">▌</span></p>
          </div>
        </div>
      </div>

      <div class="timeline">
        <div class="timeline__row reveal">
          <span class="timeline__year">2026</span>
          <div>
            <h3>IEEE IV 2026 · TLS-Assist</h3>
            <p>Co-authored publication; code and fine-tuned models released for LMDrive and BEVDriver.</p>
          </div>
        </div>
        <div class="timeline__row reveal" style="--delay: 70ms">
          <span class="timeline__year">2025</span>
          <div>
            <h3>Master's thesis · Esslingen University</h3>
            <p>Advancing multi-modal perception for closed-loop, end-to-end autonomous driving with LLMs, at the Institute for Intelligent Systems.</p>
          </div>
        </div>
        <div class="timeline__row reveal" style="--delay: 140ms">
          <span class="timeline__year">Now</span>
          <div>
            <h3>Exploring the next layer</h3>
            <p>Vision-language models, sensor fusion, and world models — and how they change what a perception stack needs to do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="container">
      <p class="eyebrow reveal">05 / Contact</p>
      <h2 class="contact__title reveal" style="--delay: 60ms">
        Let's build something that <em>sees.</em>
      </h2>
      <div class="contact__email-row reveal" style="--delay: 120ms">
        <a class="contact__email" href="mailto:noushikayilan@gmail.com">noushikayilan@gmail.com</a>
        <button class="copy-email" type="button" data-copy="noushikayilan@gmail.com">Copy</button>
      </div>
      <div class="contact__grid">
        <div class="contact__block reveal">
          <span>Elsewhere</span>
          <a href="https://github.com/nomadka" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/noushiq" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a href="https://arxiv.org/abs/2511.14391" target="_blank" rel="noreferrer">arXiv ↗</a>
        </div>
        <div class="contact__block reveal" style="--delay: 70ms">
          <span>Based in</span>
          <p>Germany</p>
          <p class="muted">Open to collaborations, research, and applied AI projects.</p>
        </div>
        <div class="contact__block reveal" style="--delay: 140ms">
          <span>Résumé</span>
          <p>Available on request.</p>
