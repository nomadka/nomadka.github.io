  .timeline h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.1;
  }

  .timeline p {
    margin-top: 6px;
    max-width: 70ch;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Contact */
  .contact {
    padding-top: clamp(72px, 10vw, 130px);
    padding-bottom: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }

  .contact__title {
    max-width: 14ch;
    margin-top: 20px;
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 7vw, 6.8rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
  }

  .contact__title em {
    font-style: italic;
    color: var(--amber);
  }

  .contact__email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 30px;
  }

  .contact__email {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 1.7vw, 1.2rem);
    letter-spacing: 0.01em;
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 4px;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .contact__email:hover {
    color: var(--amber);
    border-color: var(--amber);
  }

  .copy-email {
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .copy-email:hover {
    border-color: var(--amber);
    color: var(--amber);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: clamp(48px, 7vw, 76px);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }

  .contact__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }

  .contact__block > span {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .contact__block a,
  .contact__block p {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  .contact__block a {
    transition: color 0.2s var(--ease);
  }

  .contact__block a:hover {
    color: var(--amber);
  }

  .contact__block .muted {
    max-width: 34ch;
    margin-top: 2px;
    font-size: 12px;
    color: var(--muted-2);
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      max-width: 720px;
    }

    .work-feature {
      grid-template-columns: 1fr;
    }

    .work-feature__media {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }

    .paper-grid,
    .about-grid {
      grid-template-columns: 1fr;
    }

    .paper-figure {
      max-width: 100%;
    }
  }

  @media (max-width: 860px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }

    .stack-pipeline {
      grid-template-columns: 1fr 1fr;
    }

    .stack-step + .stack-step {
      border-left: 0;
    }

    .stack-step:nth-child(odd) {
      padding-left: 0;
    }

    .stack-step:nth-child(even) {
      padding-left: 24px;
      border-left: 1px solid var(--line);
    }

    .stack-step:nth-child(n + 3) {
