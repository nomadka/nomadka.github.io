    }

    .vision-frame__foot {
      gap: 8px;
      padding-inline: 10px;
    }

    .vision-frame__foot div + div {
      padding-left: 9px;
    }

    .vision-frame__foot strong {
      font-size: 9px;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }

    .work-feature__metric {
      flex-direction: column;
      gap: 8px;
    }

    .paper-metrics {
      gap: 20px 30px;
    }

    .stack-pipeline {
      grid-template-columns: 1fr;
    }

    .stack-step,
    .stack-step + .stack-step,
    .stack-step:nth-child(even) {
      padding: 18px 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .stack-step:first-child {
      border-top: 0;
    }

    .stack-step:not(:first-child)::before {
      left: 0;
    }

    .stack-grid {
      grid-template-columns: 1fr;
    }

    .timeline__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type HeroSlide = {
    label: string;
    src: string;
    width: number;
    height: number;
    alt: string;
    caption: string;
    href: string;
    link: string;
    foot: Array<{ label: string; value: string; tone?: 'amber' | 'green' }>;
    detection?: { x: string; y: string; w: string; h: string; label: string };
  };

  const root = document.querySelector<HTMLElement>('[data-slideshow]');
  const slides: HeroSlide[] = root?.dataset.slides ? JSON.parse(root.dataset.slides) : [];

  if (root && slides.length > 1) {
    const image = root.querySelector<HTMLImageElement>('[data-slide-image]');
    const slideLabel = root.querySelector<HTMLElement>('[data-slide-label]');
    const count = root.querySelector<HTMLElement>('[data-slide-count]');
    const caption = document.querySelector<HTMLElement>('[data-slide-caption]');
    const link = document.querySelector<HTMLAnchorElement>('[data-slide-link]');
    const linkLabel = document.querySelector<HTMLElement>('[data-slide-link-label]');
    const footLabels = root.querySelectorAll<HTMLElement>('[data-slide-foot-label]');
    const footValues = root.querySelectorAll<HTMLElement>('[data-slide-foot]');
    const detection = root.querySelector<HTMLElement>('[data-slide-detection]');
    const detectionLabel = root.querySelector<HTMLElement>('[data-slide-detection-label]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-slide-toggle]');
    const previous = root.querySelector<HTMLButtonElement>('[data-slide-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-slide-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const interval = 6500;
    let index = 0;
    let playing = false;
    let timer: number | undefined;
    let swapping = false;

    const pad = (value: number) => String(value).padStart(2, '0');

    const render = (slide: HeroSlide) => {
      if (!image) return;
      image.src = slide.src;
      image.alt = slide.alt;
      image.width = slide.width;
      image.height = slide.height;
      if (slideLabel) slideLabel.textContent = slide.label;
      if (count) count.textContent = `${pad(index + 1)} / ${pad(slides.length)}`;
      if (caption) caption.textContent = slide.caption;
      if (link) link.href = slide.href;
      if (linkLabel) linkLabel.textContent = slide.link;
      footLabels.forEach((element, position) => {
        const item = slide.foot[position];
        if (item) element.textContent = item.label;
      });
      footValues.forEach((element, position) => {
        const item = slide.foot[position];
        if (!item) return;
        element.textContent = item.value;
        element.classList.toggle('is-amber', item.tone === 'amber');
        element.classList.toggle('is-green', item.tone === 'green');
      });
      if (detection && detectionLabel) {
        if (slide.detection) {
          detection.hidden = false;
          detection.style.setProperty('--x', slide.detection.x);
          detection.style.setProperty('--y', slide.detection.y);
          detection.style.setProperty('--w', slide.detection.w);
          detection.style.setProperty('--h', slide.detection.h);
          detectionLabel.textContent = slide.detection.label;
        } else {
          detection.hidden = true;
        }
      }
    };

    const show = async (target: number, instant = false) => {
      if (swapping || !image) return;
      const nextIndex = (target + slides.length) % slides.length;
      if (nextIndex === index && !instant) return;
      const slide = slides[nextIndex];
      index = nextIndex;
      if (instant || reduceMotion.matches) {
        render(slide);
        return;
      }
      swapping = true;
      image.classList.add('is-out');
      await new Promise((resolve) => window.setTimeout(resolve, 180));
      render(slide);
      try {
        await image.decode();
      } catch {
        /* decode can reject on cached or unsupported sources; the new frame still paints */
      }
      image.classList.remove('is-out');
      swapping = false;
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = () => {
      stop();
      if (!playing) return;
      timer = window.setInterval(() => {
        void show(index + 1);
      }, interval);
    };

    const setPlaying = (value: boolean) => {
      playing = value;
      root.dataset.playing = String(value);
      toggle?.setAttribute('aria-label', value ? 'Pause slideshow' : 'Play slideshow');
      start();
    };

    previous?.addEventListener('click', () => {
      void show(index - 1);
      start();
    });

    next?.addEventListener('click', () => {
      void show(index + 1);
      start();
    });

    toggle?.addEventListener('click', () => setPlaying(!playing));

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reduceMotion.addEventListener('change', (event) => {
      if (event.matches) setPlaying(false);
    });

    const preload = () => {
      slides.slice(1).forEach((slide) => {
        const preloadImage = new Image();
        preloadImage.src = slide.src;
      });
    };

    if (document.readyState === 'complete') preload();
    else window.addEventListener('load', preload, { once: true });

    setPlaying(!reduceMotion.matches);
  }
</script>
