---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Signal lost"
  description="That page could not be found. Return to the known map."
  noindex
>
  <section class="lost">
    <div class="container">
      <div class="lost__top">
        <p class="eyebrow">System / 404</p>
        <span class="mono muted">Route not found</span>
      </div>

      <div class="lost__grid">
        <div class="lost__copy">
          <p class="lost__code">ERR · NO MATCHING ROUTE</p>
          <h1>Signal <em>lost.</em></h1>
          <p class="lost__lead">
            The detector returned zero boxes for this route. The page may have moved, the link may have been
            mis-calibrated, or it never existed in the first place.
          </p>
          <div class="lost__actions">
            <a class="btn btn--primary" href="/">
              Return to the known map
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="btn btn--ghost" href="/work/">Browse the work</a>
          </div>
          <nav class="lost__links" aria-label="Useful pages">
            <a href="/work/tls-assist/"><span>01</span> TLS-Assist</a>
            <a href="/research/"><span>02</span> Research</a>
            <a href="/about/"><span>03</span> About</a>
            <a href="/#contact"><span>04</span> Contact</a>
          </nav>
        </div>

        <div class="lost__frame" aria-label="Perception log showing no detections">
          <div class="lost__bar">
            <span class="lost__live"><i></i> PERCEPTION LOG</span>
            <span>FRAME 0404</span>
          </div>
          <div class="lost__viewport">
            <span class="lost__corner lost__corner--tl"></span>
            <span class="lost__corner lost__corner--tr"></span>
            <span class="lost__corner lost__corner--bl"></span>
            <span class="lost__corner lost__corner--br"></span>
            <span class="lost__cross lost__cross--x" aria-hidden="true"></span>
            <span class="lost__cross lost__cross--y" aria-hidden="true"></span>
            <span class="lost__sweep" aria-hidden="true"></span>
            <span class="lost__reticle" aria-hidden="true"></span>
            <div class="lost__message">
              <span>NO SIGNAL</span>
              <p>target object: <b>page</b><br />detections: <b>0</b></p>
            </div>
            <span class="lost__coord lost__coord--a">x 000.00</span>
            <span class="lost__coord lost__coord--b">y 000.00</span>
            <span class="lost__coord lost__coord--c">z 000.00</span>
          </div>
          <div class="lost__foot">
            <div><span>OBJECTS</span><strong>00</strong></div>
            <div><span>CONFIDENCE</span><strong>0.00</strong></div>
            <div><span>STATUS</span><strong class="lost__status">LOST</strong></div>
          </div>
        </div>
      </div>

      <p class="lost__note">
        If a link from this site brought you here, it is a bug — not a dead end. Report it at
        <a href="mailto:noushikayilan@gmail.com">noushikayilan@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    min-height: 82vh;
    padding-top: clamp(126px, 15vw, 176px);
    padding-bottom: clamp(60px, 8vw, 100px);
    overflow: hidden;
  }

  .lost::before {
    content: "";
    position: absolute;
    top: 8%;
    right: -8%;
    width: 48vw;
    height: 48vw;
    max-width: 680px;
    max-height: 680px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 181, 71, 0.075), transparent 68%);
    pointer-events: none;
  }

  .lost__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .lost__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    margin-top: clamp(34px, 5vw, 58px);
  }

  .lost__code {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
  }

  .lost h1 {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 10vw, 9rem);
    line-height: 0.86;
    letter-spacing: -0.04em;
  }

  .lost h1 em {
    font-style: italic;
    color: var(--amber);
  }

  .lost__lead {
    max-width: 54ch;
    margin-top: 26px;
    font-size: clamp(1rem, 1.4vw, 1.14rem);
    line-height: 1.65;
    color: var(--muted);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .lost__links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 26px;
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .lost__links a {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .lost__links a:hover {
    color: var(--amber);
  }

  .lost__links span {
    font-size: 8px;
    color: var(--muted-2);
  }

  /* Frame */
  .lost__frame {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: rgba(11, 15, 20, 0.92);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  .lost__bar,
  .lost__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 14px;
    background: rgba(7, 9, 12, 0.7);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .lost__bar {
    border-bottom: 1px solid var(--line);
  }

  .lost__live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
  }

  .lost__live i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 9px rgba(255, 107, 107, 0.8);
    animation: blink 1.8s steps(2, start) infinite;
  }

  .lost__viewport {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background:
      repeating-linear-gradient(0deg, transparent 0 3px, rgba(255, 255, 255, 0.018) 3px 4px),
      linear-gradient(180deg, #0b1015, #070a0e);
  }

  .lost__viewport::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(244, 241, 234, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 234, 0.035) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle at 50% 50%, #000 18%, transparent 76%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 18%, transparent 76%);
  }

  .lost__corner {
    position: absolute;
    z-index: 2;
    width: 20px;
    height: 20px;
    border-color: rgba(244, 241, 234, 0.42);
    border-style: solid;
  }

  .lost__corner--tl { top: 14px; left: 14px; border-width: 1px 0 0 1px; }
  .lost__corner--tr { top: 14px; right: 14px; border-width: 1px 1px 0 0; }
  .lost__corner--bl { bottom: 14px; left: 14px; border-width: 0 0 1px 1px; }
  .lost__corner--br { bottom: 14px; right: 14px; border-width: 0 1px 1px 0; }

  .lost__cross {
    position: absolute;
    background: rgba(244, 241, 234, 0.1);
  }

  .lost__cross--x { top: 50%; left: 10%; right: 10%; height: 1px; }
  .lost__cross--y { left: 50%; top: 10%; bottom: 10%; width: 1px; }

  .lost__sweep {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    top: -25%;
    height: 25%;
    background: linear-gradient(180deg, transparent, rgba(255, 107, 107, 0.075), transparent);
    mix-blend-mode: screen;
    animation: sweep 6.5s linear infinite;
    pointer-events: none;
  }

  .lost__reticle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 74px;
    height: 74px;
    border: 1px solid rgba(255, 181, 71, 0.34);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .lost__reticle::before,
  .lost__reticle::after {
    content: "";
    position: absolute;
    background: rgba(255, 181, 71, 0.34);
  }

  .lost__reticle::before {
    top: 50%;
    left: -14px;
    right: -14px;
    height: 1px;
  }

  .lost__reticle::after {
    left: 50%;
    top: -14px;
    bottom: -14px;
    width: 1px;
  }

  .lost__message {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
  }

  .lost__message > span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--red);
  }

  .lost__message p {
    font-family: var(--font-mono);
    font-size: 8.5px;
    line-height: 1.9;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .lost__message b {
    font-weight: 500;
    color: var(--muted);
  }

  .lost__coord {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.08em;
    color: var(--muted-2);
  }

  .lost__coord--a { top: 18px; left: 48px; }
  .lost__coord--b { top: 18px; right: 48px; }
  .lost__coord--c { bottom: 18px; left: 48px; }

  .lost__foot {
    border-top: 1px solid var(--line);
    padding-block: 12px;
  }

  .lost__foot div {
    display: grid;
    gap: 3px;
  }

  .lost__foot div + div {
    padding-left: 14px;
    border-left: 1px solid var(--line);
  }

  .lost__foot span {
    font-size: 7px;
    color: var(--muted-2);
  }

  .lost__foot strong {
    font-size: 9px;
    font-weight: 500;
    color: var(--text);
  }

  .lost__status {
    color: var(--red) !important;
  }

  .lost__note {
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.8;
    color: var(--muted-2);
  }

  .lost__note a {
    color: var(--muted);
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .lost__note a:hover {
    color: var(--amber);
    border-color: var(--amber);
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @keyframes sweep {
    0% { transform: translateY(0); }
    100% { transform: translateY(510%); }
  }

  @media (max-width: 940px) {
    .lost__grid {
      grid-template-columns: 1fr;
    }

    .lost__frame {
      max-width: 620px;
    }
  }

  @media (max-width: 640px) {
    .lost__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .lost h1 {
      font-size: clamp(3.8rem, 19vw, 6rem);
    }

    .lost__foot {
      gap: 8px;
      padding-inline: 10px;
    }

    .lost__foot div + div {
      padding-left: 8px;
    }
  }
</style>
