      <a class="btn btn--primary" href="https://github.com/nomadka/wood_defects" target="_blank" rel="noreferrer">
        Repository
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="btn btn--ghost" href="https://www.kaggle.com/datasets/nomihsa965/large-scale-image-dataset-of-wood-surface-defects" target="_blank" rel="noreferrer">Dataset</a>
    </div>
    <p class="case-note">
      Dataset credit: “Large-Scale Image Dataset of Wood Surface Defects” on Kaggle. The model, training run, and
      evaluation are my own.
    </p>
  </CaseSection>
</CaseLayout>
