---
interface Props {
  number: string;
  title: string;
  id?: string;
}

const { number, title, id } = Astro.props;
---

<section class="case-section" id={id}>
  <div class="case-section__head">
    <span class="case-section__number">{number}</span>
    <h2>{title}</h2>
  </div>
  <div class="case-section__body">
    <slot />
  </div>
</section>
