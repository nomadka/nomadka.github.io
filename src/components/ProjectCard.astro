---
interface Props {
  href: string;
  index: string;
  title: string;
  description: string;
  image: string;
  alt: string;
  meta: string;
  tags: string[];
}

const { href, index, title, description, image, alt, meta, tags } = Astro.props;
---

<a class="project-card card reveal" href={href}>
  <div class="project-card__media">
    <img src={image} alt={alt} loading="lazy" decoding="async" width="1200" height="900" />
    <span class="project-card__meta">{meta}</span>
  </div>
  <div class="project-card__body">
    <div class="project-card__head">
      <span class="mono muted">{index}</span>
      <span class="project-card__arrow" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <ul class="tag-list">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-2);
  }

  .project-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(7, 9, 12, 0.42));
    pointer-events: none;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease), filter 0.7s var(--ease);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.035);
    filter: saturate(1.08);
  }

  .project-card__meta {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 5px 8px;
    border: 1px solid rgba(244, 241, 234, 0.18);
    border-radius: 3px;
    background: rgba(7, 9, 12, 0.72);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
  }

  .project-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-card__arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .project-card:hover .project-card__arrow {
    border-color: var(--amber);
    color: var(--amber);
    transform: translate(2px, -2px);
  }

  h3 {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  p {
    flex: 1;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .tag-list {
    margin-top: 6px;
  }
</style>
